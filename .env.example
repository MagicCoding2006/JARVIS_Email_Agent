# ───────────────────────────────────────────────────────────────────────────
# AI SDR/BDR System — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Use a NEW rotated password. Your old credentials were committed to a public
# repo and must be considered compromised — rotate them in MongoDB Atlas.
MONGODB_URI=""
MONGODB_DB="email_db"

# ── LLM: worker role (high-volume writing/classification) ───────────────────
# "GPT-5.4 mini" — set the model to whatever your provider actually exposes.
# The adapter is OpenAI-compatible, so any OpenAI-compatible endpoint works.
# WORKER_AUTH="api-key" uses WORKER_API_KEY. "openai-oauth" reads a local auth
# file directly. "openai-oauth-proxy" uses the internal harness configured below.
WORKER_AUTH="api-key"
WORKER_BASE_URL="https://api.openai.com/v1"
WORKER_API_KEY=""
WORKER_MODEL="gpt-5.4-mini"
WORKER_OAUTH_FILE=""

# ── LLM: strategist role (daily/weekly analysis, experiment planning) ───────
# "GLM-5.2 max". GLM (Zhipu) is OpenAI-compatible.
#   China endpoint:        https://open.bigmodel.cn/api/paas/v4
#   International (z.ai):   https://api.z.ai/api/paas/v4
STRATEGIST_AUTH="api-key"
STRATEGIST_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
STRATEGIST_API_KEY=""
STRATEGIST_MODEL="glm-5.2-max"
STRATEGIST_OAUTH_FILE=""

# ── OpenAI OAuth harness (local or Railway; no OpenAI API key) ──────────────
# Starts an internal loopback-only OpenAI-compatible proxy with the app.
OPENAI_OAUTH_PROXY_ENABLED="false"
OPENAI_OAUTH_PROXY_HOST="127.0.0.1"
OPENAI_OAUTH_PROXY_PORT="10531"
# On Railway, mount a persistent Volume at /data. The base64 secret bootstraps
# auth.json only when the persistent file does not exist; token refreshes are
# then written back to that file and survive deploys.
OPENAI_OAUTH_FILE="/data/openai-oauth/auth.json"
OPENAI_OAUTH_AUTH_JSON_BASE64=""
# Change this value whenever OPENAI_OAUTH_AUTH_JSON_BASE64 is replaced. Railway
# will overwrite the persisted auth file once, then preserve refreshed tokens.
OPENAI_OAUTH_AUTH_SEED_VERSION=""

# ── Email sending ───────────────────────────────────────────────────────────
# Use "graph" for Microsoft 365 on hosts that block outbound SMTP, or "smtp".
EMAIL_TRANSPORT="smtp"

# Microsoft Graph app-only OAuth. Required when EMAIL_TRANSPORT="graph".
# Entra app needs Microsoft Graph > Application permission > Mail.Send,
# followed by tenant admin consent.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# SMTP settings. Ignored for outbound sending when EMAIL_TRANSPORT="graph";
# mailbox SMTP credentials may still be used by IMAP reply polling.
# Works with Google Workspace, Zoho, Mailgun SMTP, etc.
# For Gmail: use an App Password (requires 2FA), host smtp.gmail.com port 465.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
# The visible From. SMTP_USER often must match or be an alias of this.
FROM_NAME=""
FROM_EMAIL=""
# Where replies should go (defaults to FROM_EMAIL).
REPLY_TO_EMAIL=""

# Safety throttles so you don't torch your domain reputation.
DAILY_SEND_LIMIT="40"
MAX_SENDS_PER_RUN="20"
MIN_SECONDS_BETWEEN_SENDS="45"
# Dry run = build + log emails but DON'T actually send. Start with this true.
DRY_RUN="true"
# Hard cap on sends per day to any single RECIPIENT domain (e.g. don't send
# more than this many emails to different people @acme.com in one day) —
# protects one target company's mail server/reputation from being hammered.
# Enforced in code (workers/dispatcher.ts); the agent cannot change it. <=0 disables it.
MAX_SENDS_PER_RECIPIENT_DOMAIN_PER_DAY="30"

# ── Mailbox rotation pool (optional) ────────────────────────────────────────
# To send volume without burning one domain, spread sends across several
# mailboxes. Each prospect gets ONE sticky mailbox for their whole thread.
# Leave MAILBOXES empty to use the single SMTP_* mailbox above (back-compatible).
#
# Example volume profile for 5 inboxes targeting ~150/day total:
#   MAILBOX_DAILY_CAP=30, AGENT_DAILY_SEND_CEILING=175 (warmup ramps each
#   mailbox 5→30 over ~5 days automatically).
#
# JSON array; per mailbox only "email" + creds are required, the rest default
# to the SMTP_*/FROM_* values above. Or set MAILBOXES_FILE to a path instead.
# Fields: email, fromName?, replyTo?, host?, port?, secure?, user?, pass?,
#         dailyCap?, warmup?
# MAILBOXES='[{"email":"sales1@you.com","user":"sales1@you.com","pass":"app-pw-1"},{"email":"sales2@you.com","user":"sales2@you.com","pass":"app-pw-2"}]'
# MAILBOXES_FILE="./mailboxes.json"

# Per-mailbox ceiling once fully warmed (per-mailbox "dailyCap" overrides this).
MAILBOX_DAILY_CAP="40"
# Warmup ramp: each mailbox starts at WARMUP_START_PER_DAY emails/day and adds
# WARMUP_INCREMENT_PER_DAY each day since its first send, capped at WARMUP_MAX_PER_DAY.
WARMUP_ENABLED="true"
WARMUP_START_PER_DAY="5"
WARMUP_INCREMENT_PER_DAY="5"
WARMUP_MAX_PER_DAY="40"

# ── Tracking server ─────────────────────────────────────────────────────────
# Public base URL where this project's tracking server is reachable.
# Opens/clicks only work if prospects can reach this from the internet.
# You can keep using your existing Cloud Run pixel host here instead.
TRACKING_BASE_URL="http://localhost:8787"
TRACKING_PORT="8787"
# Shared secret for the inbound-reply webhook (Instantly/SES/Mailgun -> us).
REPLY_WEBHOOK_SECRET="change-me"

# ── Inbound replies via IMAP (optional) ─────────────────────────────────────
# If you DON'T have a provider POSTing to /webhook/reply, turn this on to poll
# your sending mailboxes over IMAP and auto-capture replies. Auth reuses each
# mailbox's SMTP user/pass (or SMTP_USER/SMTP_PASS for the single mailbox).
# Per-mailbox overrides: add "imapHost"/"imapPort"/"imapSecure" to a MAILBOXES entry.
IMAP_ENABLED="false"
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_SECURE="true"
# On a mailbox's first poll, only ingest mail from the last N days.
IMAP_LOOKBACK_DAYS="14"

# ── Sending window (prospect-friendly hours, system local time) ─────────────
SEND_WINDOW_START_HOUR="8"
SEND_WINDOW_END_HOUR="17"
SEND_ON_WEEKENDS="false"

# ── Notifications ───────────────────────────────────────────────────────────
# Generic incoming-webhook URL (Slack or Discord both accept JSON {text/content}).
NOTIFY_WEBHOOK_URL=""
# Optional: also email yourself important alerts.
NOTIFY_EMAIL=""

# ── Meeting booking ─────────────────────────────────────────────────────────
# Your public Calendly/Cal.com link. When set: the writer model closes with it
# on meeting-CTA steps, AI reply drafts always include it, and templates can
# reference it as {{bookingUrl}}. Clicks are tracked. Pair with the booking
# webhook (POST /webhook/booking/calendly) so booked meetings auto-log.
BOOKING_URL=""
# The meeting length every ask references (emails, video scripts, video CTA
# button). MUST match your actual Calendly event length — asking for 5 minutes
# and booking 15 erodes trust before the call starts.
MEETING_LENGTH_MIN="15"
# Video CTA button text override; empty → "Book a 15-min demo".
BOOKING_CTA_LABEL=""
# Calendly Personal Access Token (Integrations → API & webhooks). Unlocks the
# hourly meeting-lifecycle sync: backfills booked meetings (webhook becomes
# optional), auto-sends a reminder ~24h before each meeting, records no-shows
# marked in Calendly, and queues rebooking drafts for approval. Also powers the
# agent's get_meetings tool (show-rate).
CALENDLY_API_TOKEN=""
# Auto-send the ~24h pre-meeting reminder email (transactional; respects DRY_RUN).
MEETING_REMINDERS="true"

# ── Website repo access (landing-page experiments) ──────────────────────────
# Fine-grained GitHub token with Contents:read/write + Pull requests:write on
# your marketing-site repo. The agent can READ the site and PROPOSE changes as
# pull requests only — nothing deploys until you merge.
GITHUB_TOKEN=""
WEBSITE_REPO=""        # e.g. "alexlotkov/my-landing-page"
WEBSITE_BRANCH=""      # empty = repo default branch
# Optional: agent self-improvement repo. Lets the agent inspect code and open
# reviewable PRs for small backend/tool changes. It never merges or deploys.
AGENT_CODE_REPO=""     # e.g. "alexlotkov/JARVIS_Email_Agent"
AGENT_CODE_BRANCH=""   # empty = repo default branch

# ── Compliance (required for cold/commercial email) ─────────────────────────
COMPANY_NAME="Your Company LLC"
COMPANY_ADDRESS="123 Main St, City, ST 00000"
UNSUBSCRIBE_FOOTER="true"
# A List-Unsubscribe + one-click (RFC 8058) header is added to every send
# automatically (Gmail/Yahoo require it for bulk senders) — no config needed.

# Reputation guard: auto-pause ALL sending if the recent bounce rate spikes.
# Resumes automatically once the rate drops back below the threshold.
BOUNCE_PAUSE_THRESHOLD_PCT="8"
BOUNCE_PAUSE_MIN_SAMPLE="20"
BOUNCE_WINDOW_HOURS="24"

# ── Agent brain (autonomy) ──────────────────────────────────────────────────
# Daily 08:30 update mode:
# metrics    = cheapest: Telegram campaign numbers only, no strategist/tool loop.
# review     = one strategist summary + experiment generation.
# autonomous = full tool-using daily agent; highest token usage.
AGENT_DAILY_MODE="metrics"
# semi   = low-risk actions auto-run; high-risk (new offers, launching, sourcing)
#          require your approval in Telegram.
# propose = the agent proposes everything and waits for approval.
# full    = the agent acts within hard caps (no approval). Highest risk.
AGENT_AUTONOMY="semi"
AGENT_MAX_STEPS="12"
# Allow scheduled autonomous cycles to inspect the agent repo and prepare
# approval-gated self-improvement PRs. The agent can never merge or deploy them.
AGENT_AUTONOMOUS_CODE="false"
AGENT_MAX_LEADS_PER_SOURCE="25"
# Hard ceilings the agent's set_send_pace tool can never exceed, no matter what
# it decides. Real throughput is still further bounded by per-mailbox warmup
# caps and MAX_SENDS_PER_RECIPIENT_DOMAIN_PER_DAY above, which it can't touch.
AGENT_MAX_PER_RUN_CEILING="50"
AGENT_DAILY_SEND_CEILING="200"
# Daily budgets for the agent's self-serve funnel-feeding (code-enforced):
# auto_enroll enrollments/day into ACTIVE campaigns, and leads/day imported by
# free discovery. Within these budgets the agent acts without approval.
AGENT_AUTO_ENROLL_PER_DAY="200"
AGENT_AUTO_DISCOVER_PER_DAY="50"

# ── Telegram chat + approvals ───────────────────────────────────────────────
# Create a bot with @BotFather → token. Get your chat id from @userinfobot.
# TELEGRAM_CHAT_ID is the default owner chat for startup messages/notifications.
# TELEGRAM_ALLOWED_USER_IDS lets trusted users talk to the bot from private chats
# or groups. Use Telegram numeric user IDs, comma-separated.
# TELEGRAM_ALLOWED_CHAT_IDS lets everyone in specific chats/groups talk to it.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALLOWED_USER_IDS=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# ── Web search (lead research + free lead discovery) ────────────────────────
# provider:
#   "duckduckgo" — FREE, no key (we parse DDG's HTML). Default. Can rate-limit.
#   "searxng"    — FREE, self-hosted metasearch (most robust). Set SEARXNG_URL.
#                  Run one:  docker run -d -p 8080:8080 searxng/searxng
#                  then enable the JSON format in its settings.yml.
#   "serper"     — paid (serper.dev), most reliable. Needs SEARCH_API_KEY.
#   "tavily"     — paid (tavily.com). Needs SEARCH_API_KEY.
SEARCH_PROVIDER="duckduckgo"
SEARCH_API_KEY=""
SEARXNG_URL=""

# ── Free lead discovery (search → email pattern → verify; no Apollo needed) ──
# SMTP-probe verification uses port 25. Many home ISPs block it — then we fall
# back to "guessed" emails and let bounces filter them out.
DISCOVERY_SMTP_PROBE="true"
DISCOVERY_IMPORT_GUESSED="true"

# ── Apollo.io lead sourcing (OPTIONAL, PAID — needs an API plan) ─────────────
# Leave blank if you have no Apollo API plan; use discover_leads instead.
APOLLO_API_KEY=""

# ── Apify lead sourcing (OPTIONAL, PAID actor runs) ─────────────────────────
# Actor id can be "username/actor-name" or the Apify actor id.
APIFY_API_TOKEN=""
APIFY_LEADS_ACTOR_ID="peakydev/leads-scraper-ppe"
APIFY_MAX_RESULTS_PER_RUN="30000"
APIFY_MAX_COST_PER_RUN_USD="30"
APIFY_POLL_SECONDS="10"

# ── Gemini TTS (video voiceover) ────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"
GEMINI_TTS_VOICE="Achird"
# On a 429/overload, wait the server-suggested delay and retry this many times.
# Handles the free tier's 3 req/min limit; the 15 req/day limit needs billing.
GEMINI_TTS_MAX_RETRIES="4"

# ── Video rendering (Remotion) ──────────────────────────────────────────────
# Run `cd remotion && npm install` once, then flip this to true.
VIDEO_ENABLE_REMOTION="false"
VIDEO_OUTPUT_DIR="data/videos"
# Try to capture a lead's website as a video background when a website exists.
VIDEO_CAPTURE_WEBSITE="true"
# Optional: override Chrome/Chromium executable for screenshot capture.
VIDEO_CHROME_PATH=""
# Remotion render concurrency (parallel Chrome tabs). Caps peak RAM. Keep at 1–2
# on small hosts like Railway; 0 lets Remotion pick (uses all cores → more RAM).
VIDEO_RENDER_CONCURRENCY="0"
